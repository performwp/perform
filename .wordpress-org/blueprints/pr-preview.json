{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/options-general.php?page=perform_settings",
    "features": {
        "networking": true
    },
    "preferredVersions": {
        "php": "8.4",
        "wp": "6.9"
    },
    "steps": [
        {
            "step": "defineWpConfigConsts",
            "consts": {
                "IS_PLAYGROUND_PREVIEW": true
            }
        },
        {
            "step": "login"
        },
        {
            "step": "installPlugin",
            "pluginZipFile": {
                "resource": "url",
                "url": "{{ARTIFACT_URL:perform}}"
            },
            "options": {
                "activate": true
            }
        }
    ]
}
