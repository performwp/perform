{
  "name": "perform",
  "version": "1.8.0-beta.2",
  "description": "Web Performance Optimization Plugin for WordPress",
  "homepage": "https://github.com/performwp/perform#readme",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "PerformWP",
    "email": "hello@performwp.com",
    "url": "https://performwp.com",
    "role": "developer"
  },
  "bugs": {
    "url": "https://github.com/performwp/perform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/performwp/perform.git"
  },
  "scripts": {
    "prebuild": "node scripts/assert-node-version.cjs",
    "start": "wp-scripts start --mode development",
    "build": "wp-scripts build --mode production",
    "i18n:pot": "wp i18n make-pot . languages/perform.pot --slug=perform --domain=perform --include=perform.php,uninstall.php,src,assets/src/js --exclude='*.test.jsx,*.test.js'",
    "format": "wp-scripts format",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
    "lint:js": "eslint --ext .jsx \"assets/src/**/*.js\" \"assets/src/**/*.jsx\" postcss.config.js webpack.config.js",
    "test:unit": "wp-scripts test-unit-jest --runInBand",
    "plugin-zip": "rm -rf build/perform perform.zip && mkdir -p build/perform && rsync -rc --exclude-from=.distignore ./ build/perform/ --delete --delete-excluded && cp composer.json composer.lock build/perform/ && cp -R dependencies build/perform/ && composer install --working-dir=build/perform --no-dev --prefer-dist --optimize-autoloader --no-interaction --no-progress --no-scripts && rm -rf build/perform/dependencies && rm -f build/perform/composer.lock && rm -rf build/perform/vendor/bin build/perform/vendor/composer/installers && cd build && zip -qr ../perform.zip perform && cd .. && rm -rf build/perform",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node tests/e2e/run-ci.mjs",
    "wp-env": "wp-env"
  },
  "engines": {
    "node": ">=24.22.1 <25.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@wordpress/components": "^29.12.0",
    "@wordpress/element": "^6.26.0",
    "@wordpress/env": "^12.0.0",
    "@wordpress/eslint-plugin": "^27.0.0",
    "@wordpress/jest-preset-default": "14.2.0",
    "@wordpress/i18n": "^6.9.0",
    "@wordpress/scripts": "^37.0.0",
    "@wordpress/stylelint-config": "^23.38.0",
    "autoprefixer": "^10.5.0",
    "babel-jest": "30.5.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-jest": "^29.0.0",
    "file-loader": "^6.2.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "mini-css-extract-plugin": "^2.8.1",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^9.5.4",
    "prettier": "npm:wp-prettier@^3.9.6",
    "sharp": "^0.35.5",
    "style-loader": "^3.3.4",
    "svgo": "^4.1.0",
    "terser-webpack-plugin": "5.6.1"
  }
}
